# CloudFront domain for travel photos (S3: brad-m-travel-pics/{tripId}/{filename}).
# Photo filenames are listed per trip as `photoIds` in src/data/travelData.js.
# Copy to .env locally; set the same variable in Netlify → Environment variables (then redeploy).
# No trailing slash.
VITE_TRAVEL_PHOTOS_BASE_URL=https://dxxxxxxxx.cloudfront.net

# CARTO basemap API key (https://carto.com/basemaps/apikey). Restrict it to your site's domain
# (add localhost for local dev). It ends up in the public bundle, so it is not a secret, but keep it
# out of git. Set the same variable in Netlify → Environment variables (then redeploy).
VITE_CARTO_API_KEY=
